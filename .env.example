# Copy to .env and fill in. NEVER commit .env. All values below are placeholders.
MI_DB_PATH=data/marketintel.sqlite3
MI_TIMEZONE=Asia/Tehran
MI_LOG_LEVEL=INFO

# Telegram Bot API (create a bot with @BotFather; add it as ADMIN to your own channel
# and to every source channel where the owners have authorized it)
MI_TELEGRAM_BOT_TOKEN=
# Target channel for publishing, e.g. @my_channel or -100xxxxxxxxxx
MI_PUBLISH_CHAT_ID=
# Set to 1 ONLY when you really want to send to the real channel. Default: dry-run (console sender).
MI_LIVE_PUBLISH=0

# Admin dashboard
MI_ADMIN_SECRET_KEY=change-me-to-a-long-random-string
MI_ADMIN_HOST=127.0.0.1
MI_ADMIN_PORT=8080
MI_ADMIN_COOKIE_SECURE=0

# Optional: Telethon/MTProto (only for channels your own account may read)
MI_TG_API_ID=
MI_TG_API_HASH=
MI_TG_SESSION_PATH=data/telethon.session

# Optional AI extraction provider (disabled by default; not required)
MI_AI_EXTRACTOR=none
